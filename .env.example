# StickerMotion settings. Copy this file to .env and fill in the values.
# .env is git-ignored; never commit real tokens or passwords.
# See docs/configuration.md for details on every variable.

# --- Web UI -------------------------------------------------------------------

# Required. The only login of the web UI (single user, no accounts).
APP_PASSWORD=

# Required for generation. Replicate API token (https://replicate.com/account/api-tokens).
# Without it the UI still opens, but describing and generating fail.
REPLICATE_API_TOKEN=

# Where stickers, the SQLite database, the clip cache and the cost journal are stored.
# Default: data (relative to the working directory). Docker Compose sets /data itself.
DATA_DIR=data

# Spend cap per calendar day, USD. Default: 1.
DAILY_BUDGET_USD=1

# Spend cap for one generation (description, decor, focus and the video clip), USD.
# Default: 0.10. With several variants the cap applies to each variant.
RUN_BUDGET_USD=0.10

# Maximum size of an uploaded PNG, MB. Default: 10.
MAX_UPLOAD_MB=10

# Key that signs the session cookie. Leave empty to have a random key generated
# and kept in DATA_DIR/.secret_key on first start.
SECRET_KEY=

# Set to 1 when the UI is served over HTTPS (for example behind nginx), so the
# session cookie is only sent over HTTPS. Default: 0.
COOKIE_SECURE=0

# Docker Compose only: host port bound on 127.0.0.1. Default: 8000.
STICKERMOTION_PORT=8000

# --- Publishing: Telegram (optional) -------------------------------------------

# Bot token from @BotFather. The bot creates and fills the sticker packs.
TELEGRAM_BOT_TOKEN=

# Numeric Telegram user ID of the pack owner. This user must send /start to the bot once.
TELEGRAM_OWNER_ID=

# Pack title shown in Telegram. Default: StickerMotion.
TELEGRAM_PACK_TITLE=

# Base of the pack name: <slug>_by_<bot username>, emoji pack <slug>_emoji_by_<bot username>.
# Latin letters, digits and underscores. Default: stickermotion.
TELEGRAM_PACK_SLUG=

# --- Publishing: Discord (optional) --------------------------------------------

# Bot token from the Discord Developer Portal. The bot needs the Manage Expressions
# (Create Expressions) permission on the server.
DISCORD_BOT_TOKEN=

# Numeric ID of the Discord server (guild) that receives emoji and stickers.
DISCORD_GUILD_ID=

# --- Publishing: Twitch (optional) ---------------------------------------------

# Twitch channel login, only used to build the link to the emote page of the creator
# dashboard. Twitch has no upload API, so nothing is sent to Twitch.
TWITCH_CHANNEL=
